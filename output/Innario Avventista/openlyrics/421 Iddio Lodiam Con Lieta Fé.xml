    <titles>
      <title>421 Iddio Lodiam Con Lieta Fé</title>
    </titles>
    <songbooks>
      <songbook name="Innario Avventista" entry="421"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Iddio lodiam con lieta fé:<br />clemente e giusto egli è.<br />Lodiamo l’immensa sua bontà<br />che eterna durerà!</lines>
    </verse>
  </lyrics>
