  <lyrics>
    <verse name="v1">
      <lines>Gloria al Padre, al Figlio<br />ed allo Spirito Santo.<br />Com’era nel principio<br />ed ora è sarà sempre.<br />Nei secoli, dei secoli, amen.</lines>
    </verse>
  </lyrics>
