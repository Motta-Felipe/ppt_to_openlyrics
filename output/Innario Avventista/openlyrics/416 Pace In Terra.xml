  <properties>
    <titles>
      <title>416 Pace In Terra</title>
    </titles>
    <songbooks>
      <songbook name="Innario Avventista" entry="416"/>
    </songbooks>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>Gloria a Dio negli alti cieli,<br />lode e gloria in ogni età;<br />pace in terra ai suoi fedeli<br />per la sua benignità.</lines>
    </verse>
  </lyrics>
