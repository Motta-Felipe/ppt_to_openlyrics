# PPT to OpenLyrics Converter environment variables
# Set to 'false', '0', 'no', or 'off' to keep number prefix in title
PPT_REMOVE_NUMBER_PREFIX=true

# Set to 'true' to add songbook info to the XML output
# The songbook name will be the title (without number prefix)
# If the original file has a number prefix, it will be used as the entry number
ADD_SONG_BOOK=false

# Default songbook name to use if not provided via command line
# For subfolders: overrides folder name
# For root/single files: overrides song title
SONG_BOOK_NAME=''

# Sacred names that should always be capitalized in titles (comma-separated)
# These will be properly capitalized even when converting from UPPERCASE to sentence case
SACRED_NAMES=Gesù,Dio,Signore,Cristo,Spirito Santo,Jesus,God,Lord,Christ,Holy Spirit,Mary,Padre,Father,Figlio,Salvatore,Savior,Re,King,Messia,Messiah

# Text replacements to apply during conversion
# Format: old_text|new_text,old_text2|new_text2
# Example: (tutto x 2)|(2X),(tutto 2 volte)|(2X)
TEXT_REPLACEMENTS=(tutto x 2)|(X2),(tutto 2 volte)|(X2),(2 volte)|(X2)